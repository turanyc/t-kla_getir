# Options -MultiViews
RewriteEngine On

# 1. index.php isteklerini ana dizine yönlendir (Localde alt klasör, canlıda ana domain uyumlu)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)/index\.php[?\s] [NC]
RewriteRule ^ /%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# 2. GET/HEAD .php uzantılı doğrudan linkleri uzantısız haline yönlendir (Local alt klasör yollarını korur)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Arka planda uzantısız istekleri .php dosyası varsa ona eşleştir
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
